# Copy to .env (`make env` generates one with random secrets). .env is gitignored.
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
WAREHOUSE_PASSWORD=change-me
FERNET_KEY=
JWT_SECRET=change-me
# Optional: Slack-compatible incoming webhook for failure and data-quality alerts. Empty = log only.
ALERT_WEBHOOK_URL=
